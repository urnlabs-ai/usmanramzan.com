---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import readerFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import { consulting } from '../data/consulting';
import { personJsonLd, organizationJsonLd, siteUrl } from '../data/person';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** When true, emit the default Person graph (home / about / profile pages). */
  includePerson?: boolean;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
  };
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/og.png',
  jsonLd,
  includePerson = false,
  article,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site).href;
const twitterTitle = title.includes('Usman Ramzan') ? title : `${title} | Usman Ramzan`;

const graphs: Record<string, unknown>[] = [];
if (includePerson) graphs.push(personJsonLd(), organizationJsonLd());
if (jsonLd) graphs.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
const structuredData =
  graphs.length === 0
    ? null
    : graphs.length === 1
      ? graphs[0]
      : { '@context': 'https://schema.org', '@graph': graphs.map(({ '@context': _c, ...rest }) => rest) };

const nav = [
  { href: '/about/', label: 'About' },
  { href: '/experience/', label: 'Experience' },
  { href: '/work/', label: 'Case studies' },
  { href: '/writing/', label: 'Writing' },
  { href: '/faq/', label: 'FAQ' },
];
const isActive = (href: string) =>
  href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={readerFont} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Usman Ramzan — Writing" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Usman Ramzan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime.toISOString()} />
        <meta
          property="article:modified_time"
          content={(article.modifiedTime ?? article.publishedTime).toISOString()}
        />
        <meta property="article:author" content={siteUrl} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />
    )}
  </head>
  <body id="top" class="bg-bg font-sans text-ink antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="site-shell header-inner">
        <a href="/" class="wordmark">Usman Ramzan<span class="wordmark-note">Fractional CTO · URN Labs</span></a>
        <nav aria-label="Main navigation" class="desktop-nav">
          {nav.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <a href={consulting.callHref} class="button-primary header-call">{consulting.callLabel}</a>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation">
            {nav.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
            <a href={consulting.callHref}>{consulting.callLabel}</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-shell footer-top">
        <div><p class="footer-title">Bring the technical problem. We’ll work through the next step.</p><p class="footer-description">Fractional CTO, DevOps and AI-agent consulting through URN Labs.</p></div>
        <a href={consulting.callHref} class="button-primary">{consulting.callLabel}</a>
      </div>
      <div class="site-shell footer-bottom">
        <p>&copy; {new Date().getFullYear()} Usman Ramzan · <a href={consulting.brandUrl}>URN Labs</a></p>
        <nav aria-label="Elsewhere">
          <a href={`mailto:${consulting.email}`}>{consulting.email}</a>
          <a href="https://www.linkedin.com/in/usman-ramzan">LinkedIn</a>
          <a href="https://github.com/usmanramzan">GitHub</a>
          <a href="/rss.xml">RSS</a>
          <a href="#top">Back to top ↑</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
