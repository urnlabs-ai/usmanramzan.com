---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: '/about', label: 'About' },
  { href: '/experience', label: 'Experience' },
  { href: '/writing', label: 'Writing' },
];
const isActive = (href: string) =>
  href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="top" class="bg-bg font-sans text-ink antialiased">
    <header class="border-b border-line">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
        <a href="/" class="text-sm font-semibold transition-opacity hover:opacity-70">Usman Ramzan</a>
        <nav class="hidden items-center gap-8 text-sm md:flex">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'transition-colors hover:text-ink',
                  isActive(item.href) ? 'text-ink' : 'text-muted',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="flex items-center gap-4">
          <details class="relative md:hidden">
            <summary class="list-none cursor-pointer text-sm text-muted transition-colors hover:text-ink">Menu</summary>
            <nav class="absolute right-0 top-full z-10 mt-3 min-w-40 border border-line bg-bg px-5 py-3 text-sm shadow-sm">
              {
                nav.map((item) => (
                  <a
                    href={item.href}
                    class:list={[
                      'py-2 block transition-colors hover:text-ink',
                      isActive(item.href) ? 'text-ink' : 'text-muted',
                    ]}
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>
          </details>
          <a
            href="mailto:usman.ramzan0505@gmail.com"
            class="rounded-full border border-ink px-5 py-2 text-sm transition-colors hover:bg-ink hover:text-white"
          >
            Get in touch
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <p class="font-display text-3xl font-medium tracking-tight md:text-5xl">
          Working on something that cannot go down?
          <a
            href="mailto:usman.ramzan0505@gmail.com"
            class="whitespace-nowrap underline decoration-accent underline-offset-8 transition-colors hover:text-accent"
          >
            Write to me.
          </a>
        </p>
      </div>
      <div
        class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-8 border-t border-line px-6 py-12 text-sm md:grid-cols-4"
      >
        <div>
          <p class="font-medium">Usman Ramzan</p>
          <p class="mt-1 text-muted">&copy; 2026 Muhammad Usman Ramzan</p>
        </div>
        <a
          href="https://linkedin.com/in/usman-ramzan"
          class="self-start text-muted transition-colors hover:text-ink"
        >
          LinkedIn
        </a>
        <a
          href="mailto:usman.ramzan0505@gmail.com"
          class="self-start break-all text-muted transition-colors hover:text-ink"
        >
          usman.ramzan0505@gmail.com
        </a>
        <a
          href="#top"
          class="self-start text-muted transition-colors hover:text-ink md:text-right"
        >
          Back to top
        </a>
      </div>
    </footer>

    <!-- TODO: add Cloudflare Web Analytics beacon with a real token once the site is live
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "TODO_CF_BEACON_TOKEN"}'></script>
    -->
  </body>
</html>
