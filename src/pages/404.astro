---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Usman Ramzan" description="This page does not exist.">
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="text-4xl font-semibold tracking-tight">Page not found</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        The page you are looking for does not exist or has moved.
      </p>
      <p class="mt-8 text-sm font-medium">
        <a href="/" class="text-accent underline-offset-4 hover:underline">&larr; Back to the home page</a>
      </p>
    </div>
  </section>
</Base>
