---
import Base from '../layouts/Base.astro';

const faqs = [
  { q: 'Who do you work with?', a: 'B2B SaaS founders and engineering leads who need fractional CTO support, DevOps delivery, or help developing AI assistants and agentic workflows. Engagements are scoped through URN Labs, with me as your technical contact.' },
  { q: 'How do I hire you?', a: 'Start with a 30-minute introductory call. Share your product, team, problem, and any deadline. If the engagement is a fit, we agree deliverables, responsibilities, fees, and a start date in a scoped proposal.' },
  { q: 'What does it cost?', a: 'Pricing depends on the scope, delivery responsibility, and engagement length. A focused review, an implementation project, and an ongoing fractional CTO engagement are quoted differently. Fees are agreed before work begins.' },
  { q: 'When are you available?', a: 'I confirm a start date after reviewing the scope and current commitments. Include any launch, migration, or review deadline in your enquiry. This is consulting and engineering delivery rather than emergency on-call cover.' },
  { q: 'What does a fractional CTO engagement include?', a: 'Senior technical direction for architecture, roadmap priorities, build-versus-buy decisions, infrastructure risk, and delivery. The goal is a clear set of decisions and work your team can carry through, with an ongoing review cadence where needed.' },
  { q: 'How is that different from a DevOps project?', a: 'A fractional CTO engagement covers direction and technical ownership. A DevOps project has a more focused delivery scope, such as Kubernetes infrastructure, CI/CD, observability, a cloud migration, or cost controls. We choose the format around the problem.' },
  { q: 'What does AI-agent engineering cover?', a: 'Choosing where a deterministic workflow is enough, designing retrieval and tool integrations, evaluating failures, and setting boundaries for agent actions. Start with a bounded prototype; consequential actions need explicit permissions and suitable approval gates before production rollout.' },
  { q: 'What kinds of engagements have you worked on?', a: 'Healthcare security readiness, a retrieval-based knowledge assistant for a travel company, manufacturing data remediation, and AWS/EKS operations for a media company. The case studies describe the work and its limits without disclosing client identities.' },
  { q: 'Do you guarantee compliance certification or AI accuracy?', a: 'No. Security readiness and data remediation are engineering work, not a promise of certification. For AI systems, evaluation criteria and acceptable failure behavior must be agreed for the particular use case.' },
  { q: 'When is a fractional CTO the wrong hire?', a: 'If you need someone writing production code every day, hire an engineer for that role. If your problem is one deep specialty, hire that specialist. Fractional leadership works when the team can execute and its founders are ready to act on the decisions.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---
<Base
  title="Consulting FAQ | Fractional CTO, DevOps & AI Engineering"
  description="How to hire Usman Ramzan through URN Labs, engagement pricing, availability, and the difference between fractional CTO, DevOps and AI-agent consulting."
  includePerson
  jsonLd={faqJsonLd}
>
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-5xl font-medium tracking-tight md:text-7xl">FAQ</h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Practical answers about hiring me, scoping the work, pricing, and availability.
      </p>

      <div class="mt-16 divide-y divide-line border-t border-line">
        {
          faqs.map((item) => (
            <article class="py-10">
              <h2 class="font-display text-2xl font-medium tracking-tight md:text-3xl">{item.q}</h2>
              <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{item.a}</p>
            </article>
          ))
        }
      </div>

      <p class="mt-12"><a href="/work-with-me/#call-request" class="button-primary">Book a 30-min call ↗</a></p>
      <p class="mt-6 text-sm text-muted">Read the <a href="/work/" class="text-accent underline">case studies</a> or <a href="/work-with-me/" class="text-accent underline">how working together goes</a>.</p>
    </div>
  </section>
</Base>
