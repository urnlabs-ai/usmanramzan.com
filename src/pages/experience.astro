---
import Base from '../layouts/Base.astro';

const roles = [
  {
    org: 'Eprecisio Technologies',
    title: 'Chief Technology Officer',
    dates: 'Sep 2025 &rarr; present',
    summary: 'Technology strategy for an enterprise multi-cloud Kubernetes platform.',
    points: [
      'Own the platform strategy across twelve cloud providers, from provider onboarding to what we build versus buy.',
      'Cut tenant provisioning from 8-10 minutes to about 50 seconds with shared hosted control planes and a Go provisioning engine.',
      'Fractional CTO to four companies: healthcare SOC 2 readiness (22 pentest findings remediated), a travel-sector AI assistant on Azure OpenAI and RAG for ~1,300 users, manufacturing GDPR remediation, and media AWS/EKS operations with GPU nodes.',
    ],
  },
  {
    org: 'Unifonic',
    title: 'Senior Infrastructure Engineer 2024-2025 &middot; DevOps Engineer 2022-2024',
    dates: '2022 &rarr; 2025',
    summary: 'Platform engineering on a CPaaS doing 10B+ messages a year.',
    points: [
      'Led the migration of ~40 applications and ~20 databases from AWS EKS to OCI OKE across ~10 teams, zero customer-facing downtime.',
      '$15-20K/mo cost optimization across the platform.',
      'Ran ~300 Kubernetes nodes (Rancher, EKS, OKE) behind a platform handling 10B+ messages a year.',
      'Wrote the reusable Terraform modules used org-wide; Kafka, Redis, PostgreSQL, and Cassandra running at SLA.',
    ],
  },
  {
    org: 'Emumba',
    title: 'DevOps Engineer',
    dates: '2019 &rarr; 2022',
    summary: 'Compliant cloud architecture and the Cloud Center of Excellence.',
    points: [
      'Founded the Cloud Center of Excellence, the group that set cloud standards across client projects.',
      'Delivered HIPAA/HITECH and PCI DSS compliant architectures on AWS and Azure.',
      'Ran a GKE cluster of 20+ microservices with Prometheus observability.',
    ],
  },
];
---
<Base
  title="Experience | Usman Ramzan"
  description="CTO at Eprecisio, previously Unifonic and Emumba. Multi-cloud Kubernetes, zero-downtime migrations, and compliant infrastructure."
>
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="font-display text-5xl font-medium tracking-tight md:text-7xl">Experience</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        Seven years of cloud infrastructure, from compliant client work to a 10B-message platform to
        running technology for a multi-cloud company.
      </p>

      <div class="mt-16 border-l border-line pl-8">
        {
          roles.map((role) => (
            <article class="relative pb-16 last:pb-0">
              <span class="absolute top-1.5 -left-[37px] h-2.5 w-2.5 bg-accent" aria-hidden="true" />
              <p class="font-mono text-xs text-muted">{role.dates}</p>
              <h2 class="mt-2 font-display text-xl font-medium">{role.org}</h2>
              <p class="mt-1 text-sm font-medium text-accent" set:html={role.title} />
              <p class="mt-3 max-w-2xl text-muted">{role.summary}</p>
              <ul class="mt-4 max-w-2xl space-y-2 text-sm text-muted">
                {role.points.map((point) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-px w-4 shrink-0 bg-line" aria-hidden="true" />
                    <span set:html={point} />
                  </li>
                ))}
              </ul>
            </article>
          ))
        }

        <article class="relative pt-16">
          <span class="absolute top-[70px] -left-[37px] h-2.5 w-2.5 bg-accent" aria-hidden="true" />
          <p class="font-mono text-xs text-muted">2015 &rarr; 2019</p>
          <h2 class="mt-2 font-display text-xl font-medium">FAST-NUCES</h2>
          <p class="mt-1 text-sm font-medium text-accent">BS Computer Science</p>
          <p class="mt-3 max-w-2xl text-muted">
            Graduated 2019. The degree that started all of the above.
          </p>
        </article>

        <article class="relative pt-16">
          <span class="absolute top-[70px] -left-[37px] h-2.5 w-2.5 bg-accent" aria-hidden="true" />
          <p class="font-mono text-xs text-muted">Linux Foundation</p>
          <h2 class="mt-2 font-display text-xl font-medium">CKAD</h2>
          <p class="mt-3 max-w-2xl text-muted">
            Certified Kubernetes Application Developer.
          </p>
        </article>
      </div>
    </div>
  </section>
</Base>
