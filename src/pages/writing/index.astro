---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base
  title="Writing | Usman Ramzan"
  description="Notes on cloud infrastructure, platform engineering, migrations, and fractional CTO work."
>
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="text-4xl font-semibold tracking-tight">Writing</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        Notes on cloud infrastructure, platform engineering, and running technology for companies
        that cannot afford downtime.
      </p>
      <ul class="mt-12 border-t border-line">
        {
          posts.map((post) => (
            <li class="border-b border-line py-8">
              <p class="font-mono text-xs text-muted">{fmt(post.data.pubDate)}</p>
              <a
                href={`/writing/${post.id}/`}
                class="mt-2 block text-xl font-medium underline-offset-4 hover:text-accent hover:underline"
              >
                {post.data.title}
              </a>
              <p class="mt-2 max-w-2xl text-muted">{post.data.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
