---
import { existsSync } from 'node:fs';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { siteUrl } from '../../data/person';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const contents = headings.filter(({ depth }) => depth === 2);
const updatedDate = post.data.updatedDate ?? post.data.pubDate;
const relatedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((entry) => entry.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const pageUrl = `${siteUrl}/writing/${post.id}/`;
const postImage = `/og/${post.id}.png`;
const ogImage = existsSync(`public${postImage}`) ? postImage : '/og.png';
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: updatedDate.toISOString(),
  author: {
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Muhammad Usman Ramzan',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Muhammad Usman Ramzan',
    url: siteUrl,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
  image: `${siteUrl}${ogImage}`,
  url: pageUrl,
};
---
<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={ogImage}
  article={{ publishedTime: post.data.pubDate, modifiedTime: updatedDate }}
  jsonLd={articleJsonLd}
>
  <section class="article-page">
    <div class="site-shell">
      <article>
        <header class="article-header">
          <a href="/writing/" class="article-back">← All writing</a>
          <h1>{post.data.title}</h1>
          <p class="article-meta">
            Usman Ramzan · <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            {post.data.updatedDate && <span> · Updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></span>}
          </p>
        </header>
        <div class="article-layout">
          {contents.length > 0 && (
            <nav aria-label="On this page" class="article-toc">
              <h2>On this page</h2>
              <ul>{contents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
            </nav>
          )}
          <div class="article-body">
            <div class="prose"><Content /></div>
            {relatedPosts.length > 0 && (
              <aside aria-label="More to read" class="related-writing">
                <h2>More to read</h2>
                <ul>{relatedPosts.map((entry) => <li><a href={`/writing/${entry.id}/`}>{entry.data.title} <span aria-hidden="true">↗</span></a><p>{entry.data.description}</p></li>)}</ul>
              </aside>
            )}
          </div>
        </div>
      </article>
    </div>
  </section>
</Base>
<style>
 .article-page { padding-block: 56px 80px; }
 .article-header { max-width: 820px; margin-bottom: 48px; }
 .article-back { font-size: 13px; color: var(--color-accent); }
 .article-header h1 { font-family: var(--font-display); font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.7rem); letter-spacing: -.045em; line-height: 1.12; margin-top: 28px; }
 .article-meta { color: var(--color-muted); font-size: 12px; line-height: 1.8; margin-top: 24px; }
 .article-layout { display: grid; grid-template-columns: minmax(0, 720px) minmax(0, 220px); gap: 80px; align-items: start; }
 .article-toc { grid-column: 2; grid-row: 1; position: sticky; top: 32px; border-top: 1px solid var(--color-line); padding-top: 20px; }
 .article-toc h2 { font-size: 13px; font-weight: 500; }
 .article-toc ul { padding: 0; list-style: none; margin-top: 16px; }
 .article-toc li + li { margin-top: 12px; }
 .article-toc a { font-size: 13px; line-height: 1.6; color: var(--color-muted); }
 .article-toc a:hover { color: var(--color-accent); }
 .article-body { grid-column: 1; grid-row: 1; min-width: 0; }
 .prose { font-family: 'Source Serif 4 Variable', Georgia, serif; font-size: 20px; line-height: 1.8; max-width: 62ch; }
 .prose :global(h2), .prose :global(h3) { font-family: var(--font-sans); color: var(--color-ink); }
 .prose :global(h2) { font-size: 25px; letter-spacing: -.025em; margin-top: 44px; }
 .related-writing { border-top: 1px solid var(--color-line); margin-top: 64px; padding-top: 28px; }
 .related-writing h2 { font-size: 15px; font-weight: 500; }
 .related-writing ul { list-style: none; padding: 0; margin-top: 20px; }
 .related-writing a { font-size: 19px; line-height: 1.4; color: var(--color-accent); }
 .related-writing a:hover { text-decoration: underline; text-underline-offset: 4px; }
 .related-writing p { font-size: 14px; line-height: 1.7; color: var(--color-muted); margin-top: 8px; }
 @media (max-width: 900px) {
  .article-layout { display: flex; flex-direction: column; gap: 32px; }
  .article-toc { position: static; width: 100%; padding-block: 20px; border-bottom: 1px solid var(--color-line); }
  .article-toc ul { display: flex; flex-wrap: wrap; gap: 10px 24px; }
  .article-toc li + li { margin-top: 0; }
  .article-body { width: 100%; }
 }
 @media (max-width: 600px) {
  .article-page { padding-block: 32px 48px; }
  .article-header { margin-bottom: 28px; }
  .article-header h1 { font-size: 2.2rem; margin-top: 22px; letter-spacing: -.035em; }
  .prose { font-size: 18px; line-height: 1.75; }
  .article-toc ul { display: block; }
  .article-toc li + li { margin-top: 8px; }
 }
</style>
