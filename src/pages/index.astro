---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const timeline = [
  {
    year: '2019',
    org: 'Emumba',
    line: 'DevOps engineer and founder of the Cloud Center of Excellence.',
  },
  {
    year: '2022',
    org: 'Unifonic',
    line: 'Three years on the platform sending over ten billion messages a year.',
  },
  {
    year: '2025',
    org: 'Eprecisio',
    line: 'CTO. Technology strategy for an enterprise multi-cloud Kubernetes platform.',
  },
  {
    year: 'Now',
    org: 'Fractional CTO',
    line: 'Four companies. Vague technical anxiety, ranked list of problems with owners and dates.',
  },
];
---
<Base
  title="Usman Ramzan, CTO and technical advisor"
  description="Seven years running multi-cloud platforms for companies where downtime is not an option. CTO at Eprecisio, fractional CTO to four more."
>
  <section class="pt-28 pb-24">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-6 md:grid-cols-12">
      <div class="md:col-span-8">
        <p class="text-sm text-muted">Muhammad Usman Ramzan, CTO and technical advisor</p>
        <h1
          class="mt-8 font-display text-5xl font-medium leading-[1.0] tracking-[-0.025em] text-ink md:text-7xl"
        >
          I make cloud infrastructure <span class="font-light">boring,</span><br />
          in the good way.
        </h1>
        <p class="mt-8 max-w-[52ch] text-lg text-muted">
          Seven years running multi-cloud platforms for companies where downtime is not an
          option. CTO at Eprecisio, fractional CTO to four more.
        </p>
        <p class="mt-10">
          <a
            href="/about"
            class="inline-block rounded-full bg-ink px-7 py-3 text-sm text-white transition-opacity hover:opacity-80"
          >
            Read about me
          </a>
        </p>
      </div>
      <div class="hidden md:col-span-4 md:block">
        <!-- TODO: replace with portrait photo, 800x1000 -->
        <div
          class="flex aspect-[4/5] w-full items-center justify-center border border-line bg-[#f4f4f2]"
          aria-hidden="true"
        >
          <span class="font-mono text-6xl text-[#d4d4d0]">UR</span>
        </div>
      </div>
    </div>
  </section>

  <section class="w-full bg-[#111] py-24 text-white">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 md:grid-cols-2 lg:grid-cols-4">
      {
        timeline.map((item) => (
          <div>
            <span class="block h-0.5 w-8 bg-accent" aria-hidden="true" />
            <p class="mt-4 font-mono text-sm text-accent">{item.year}</p>
            <p class="mt-3 font-display text-xl font-medium">{item.org}</p>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{item.line}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-1 gap-y-10 border-t border-line sm:grid-cols-2 md:grid-cols-4">
        {
          [
            { fig: '$15-20K/mo', what: 'monthly cloud savings, Unifonic' },
            { fig: '10B+', what: 'messages a year on the platform' },
            { fig: '~40 apps', what: 'migrated zero downtime, AWS to OCI' },
            { fig: '12', what: 'cloud providers in one platform, Eprecisio' },
          ].map(({ fig, what }) => (
            <div class="pt-6">
              <p class="font-display text-3xl font-medium tabular-nums tracking-tight md:text-4xl pr-6">{fig}</p>
              <p class="mt-2 text-sm text-muted">{what}</p>
            </div>
          ))}
      </div>

      <h2 class="mt-28 text-xl font-medium">Selected work</h2>
      <ul class="mt-6 divide-y divide-line">
        <li class="flex flex-col gap-3 py-7 md:flex-row md:items-baseline md:justify-between md:gap-8">
          <div>
            <h3 class="font-display text-xl font-medium md:text-2xl">AWS to OCI migration</h3>
            <p class="mt-1 text-muted">
              Forty applications and twenty databases moved from AWS EKS to OCI OKE across ten
              teams. Zero customer-facing downtime.
            </p>
          </div>
          <a href="/experience" class="shrink-0 text-sm text-accent underline-offset-4 hover:underline">
            How it went &rarr;
          </a>
        </li>
        <li class="flex flex-col gap-3 py-7 md:flex-row md:items-baseline md:justify-between md:gap-8">
          <div>
            <h3 class="font-display text-xl font-medium md:text-2xl">AI knowledge assistant</h3>
            <p class="mt-1 text-muted">
              A RAG assistant on Azure OpenAI for a 1,300-person travel company, so staff could
              stop digging through documents for answers.
            </p>
          </div>
          <a href="/experience" class="shrink-0 text-sm text-accent underline-offset-4 hover:underline">
            How it went &rarr;
          </a>
        </li>
        <li class="flex flex-col gap-3 py-7 md:flex-row md:items-baseline md:justify-between md:gap-8">
          <div>
            <h3 class="font-display text-xl font-medium md:text-2xl">SOC 2 readiness</h3>
            <p class="mt-1 text-muted">
              Took a healthcare SaaS from 22 open pentest findings to a clean report and
              audit-ready evidence.
            </p>
          </div>
          <a href="/experience" class="shrink-0 text-sm text-accent underline-offset-4 hover:underline">
            How it went &rarr;
          </a>
        </li>
      </ul>

      <div class="mt-28 flex items-baseline justify-between gap-6">
        <h2 class="text-xl font-medium">Recent writing</h2>
        <a href="/writing" class="shrink-0 text-sm text-muted transition-colors hover:text-ink">
          All writing
        </a>
      </div>
      <ul class="mt-6 divide-y divide-line">
        {
          posts.map((post) => (
            <li class="py-7">
              <a
                href={`/writing/${post.id}/`}
                class="font-display text-xl font-medium underline-offset-4 hover:text-accent hover:underline md:text-2xl"
              >
                {post.data.title} <span aria-hidden="true">&rarr;</span>
              </a>
              <p class="mt-1 font-mono text-xs text-muted">{fmt(post.data.pubDate)}</p>
              <p class="mt-2 text-muted">{post.data.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
