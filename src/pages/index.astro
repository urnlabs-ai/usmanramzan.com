---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const timeline = [
  { year: '2019', org: 'Cloud consultancy', line: 'DevOps engineer and founder of the Cloud Center of Excellence.' },
  { year: '2022', org: 'Messaging platform', line: 'Three years on a platform sending over ten billion messages a year.' },
  { year: '2025', org: 'Enterprise cloud platform', line: 'CTO. Technology strategy for a multi-cloud Kubernetes platform.' },
  { year: 'Now', org: 'Fractional CTO', line: 'Helping four companies turn technical uncertainty into clear priorities.' },
];
---
<Base
  title="Usman Ramzan, CTO and technical advisor"
  description="I build cloud platforms and help teams make the decisions that keep them reliable."
  includePerson
  ogType="website"
>
  <section class="home-hero">
    <div class="home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow">Muhammad Usman Ramzan <span>·</span> CTO &amp; technical advisor</p>
        <h1>Infrastructure<br class="desktop-break" /> that holds up.</h1>
        <p class="home-hero__intro">
          I build cloud platforms and help teams make the decisions that keep them reliable.
        </p>
        <a class="text-link" href="/about">More about my work <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="home-hero__portrait">
        <img
          src="/usman-portrait.jpg"
          alt="Usman Ramzan"
          width="800"
          height="1000"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="home-writing" aria-labelledby="latest-writing">
    <div class="section-heading">
      <div>

        <h2 id="latest-writing">Latest writing</h2>
      </div>
      <a class="text-link" href="/writing">All writing <span aria-hidden="true">↗</span></a>
    </div>
    <ul class="writing-list">
      {posts.map((post) => (
        <li class="writing-item">
          <div class="writing-item__date">{fmt(post.data.pubDate)}</div>
          <div>
            <a href={`/writing/${post.id}/`} class="writing-item__title">
              {post.data.title} <span aria-hidden="true">↗</span>
            </a>
            <p>{post.data.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-proof" aria-label="Selected experience and work">
    <div class="proof-metrics">
      <div><strong>$15–20K/mo</strong><span>monthly cloud savings</span></div>
      <div><strong>10B+</strong><span>messages sent each year</span></div>
      <div><strong>~40 apps</strong><span>migrated with zero downtime</span></div>
      <div><strong>12 providers</strong><span>unified in one cloud platform</span></div>
    </div>

    <div class="selected-work">
      <div class="section-heading">
        <div><h2>Selected work</h2></div>
        <a class="text-link" href="/experience">Experience <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="work-list">
        <li>
          <div><h3>AWS to OCI migration</h3><p>Forty applications and twenty databases moved across ten teams, with zero customer-facing downtime.</p></div>
          <a href="/writing/aws-to-oci-forty-apps/" aria-label="Read about the AWS to OCI migration">↗</a>
        </li>
        <li>
          <div><h3>AI knowledge assistant</h3><p>A retrieval assistant for a 1,300-person travel company, helping staff find answers across internal documents.</p></div>
          <a href="/writing/fractional-cto-four-companies/#travel-an-ai-assistant-that-had-to-be-right" aria-label="Read about the AI knowledge assistant">↗</a>
        </li>
        <li>
          <div><h3>SOC 2 readiness</h3><p>Helped a healthcare SaaS move from 22 open pentest findings to a clean report and audit-ready evidence.</p></div>
          <a href="/writing/fractional-cto-four-companies/#healthcare-soc-2-readiness" aria-label="Read about SOC 2 readiness">↗</a>
        </li>
      </ul>
    </div>

    <div class="experience-strip">
      <h2 class="experience-heading">Experience</h2>
      <div class="experience-grid">
        {timeline.map((item) => (
          <article>
            <p class="experience-grid__year">{item.year}</p>
            <h3>{item.org}</h3>
            <p class="experience-grid__line">{item.line}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .home-hero, .home-writing, .home-proof { --paper: #f7f8f6; --ink: #202922; --green: #315448; --rule: #d9dfda; }
  .home-hero { background: var(--paper); color: var(--ink); padding: clamp(3rem, 5vw, 4rem) 1.5rem clamp(2rem, 4vw, 3.5rem); }
  .home-hero__inner, .home-writing, .home-proof { width: min(100%, 70rem); margin-inline: auto; }
  .home-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(13rem, 19rem); align-items: center; gap: clamp(2rem, 8vw, 7rem); }
  .eyebrow { margin: 0; color: #65736b; font: 500 .7rem/1.5 'IBM Plex Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .eyebrow span { color: var(--green); }
  .home-hero h1 { margin: 1.4rem 0 1.25rem; font: 500 clamp(3rem, 6vw, 5rem)/.99 'IBM Plex Sans', sans-serif; letter-spacing: -.065em; }
  .home-hero__intro { max-width: 33rem; margin: 0; color: #536159; font: 400 clamp(1.05rem, 1.6vw, 1.25rem)/1.55 'Source Serif 4 Variable', serif; }
  .text-link { display: inline-flex; gap: .55rem; align-items: center; color: var(--green); font-size: .86rem; font-weight: 550; text-decoration: none; }
  .text-link:hover { text-decoration: underline; text-underline-offset: .25rem; }
  .home-hero .text-link { margin-top: 1.5rem; }
  .home-hero__portrait { width: 100%; aspect-ratio: 4 / 4.7; margin: 0; overflow: hidden; background: #e7e9e5; }
  .home-hero__portrait img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .home-writing { padding: clamp(2.5rem, 4vw, 3rem) 1.5rem; color: var(--ink); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .section-heading h2 { margin: .4rem 0 0; font: 500 clamp(1.65rem, 3vw, 2.25rem)/1.1 'IBM Plex Sans', sans-serif; letter-spacing: -.04em; }
  .section-heading > .text-link { margin-bottom: .25rem; }
  .writing-list, .work-list { padding: 0; margin: 1.5rem 0 0; list-style: none; border-top: 1px solid var(--rule); }
  .writing-item { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1.25rem; padding: 1.35rem 0; border-bottom: 1px solid var(--rule); }
  .writing-item__date { padding-top: .25rem; color: #69756e; font: .7rem/1.5 'IBM Plex Mono', monospace; }
  .writing-item__title { color: var(--ink); font: 500 1.22rem/1.3 'IBM Plex Sans', sans-serif; letter-spacing: -.025em; text-decoration: none; }
  .writing-item__title:hover { color: var(--green); }
  .writing-item__title span { color: var(--green); font-size: .85em; }
  .writing-item p, .work-list p { max-width: 48rem; margin: .4rem 0 0; color: #59665e; font: 400 .98rem/1.55 'Source Serif 4 Variable', serif; }
  .home-proof { padding: 0 1.5rem 4.5rem; color: var(--ink); }
  .proof-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--rule); }
  .proof-metrics > div { padding: 1.25rem 1rem 1.3rem 0; }
  .proof-metrics strong { display: block; font: 500 clamp(1.25rem, 2.4vw, 1.8rem)/1.2 'IBM Plex Sans', sans-serif; letter-spacing: -.04em; }
  .proof-metrics span { display: block; margin-top: .35rem; color: #657169; font: .7rem/1.5 'IBM Plex Mono', monospace; }
  .selected-work { padding-top: 3.5rem; }
  .work-list { margin-top: 1.25rem; }
  .work-list li { display: grid; grid-template-columns: minmax(0, 1fr) 2rem; align-items: center; gap: 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .work-list h3, .experience-grid h3 { margin: 0; font: 500 1rem/1.35 'IBM Plex Sans', sans-serif; }
  .work-list p { margin-top: .2rem; font-size: .9rem; }
  .work-list > li > a { color: var(--green); text-align: right; text-decoration: none; }
  .experience-strip { margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .experience-heading { font-size: 1.1rem; font-weight: 500; }
  .experience-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; margin-top: 1.1rem; }
  .experience-grid__year { margin: 0 0 .55rem; color: var(--green); font: .7rem/1.4 'IBM Plex Mono', monospace; }
  .experience-grid__line { margin: .35rem 0 0; color: #657169; font: .85rem/1.5 'Source Serif 4 Variable', serif; }
  .home-writing, .home-proof { width: min(1120px, calc(100% - 64px)); padding-inline: 0; }
  @media (max-width: 640px) {
    .home-hero__inner { grid-template-columns: 1fr; gap: 1rem; position: relative; }
    .home-hero__copy > .eyebrow { max-width: calc(100% - 100px); min-height: 65px; }
    .home-hero { padding-inline: 1.25rem; }
    .home-hero__portrait { position: absolute; right: 0; top: 0; width: 72px; aspect-ratio: 1 / 1.25; }
    .home-hero h1 { margin-top: 1.1rem; font-size: clamp(2.45rem, 10vw, 3.3rem); letter-spacing: -.06em; }
    .desktop-break { display: none; }
    .home-hero__intro { font-size: 1rem; }
    .home-writing, .home-proof { width: calc(100% - 40px); padding-inline: 0; }
    .writing-item { grid-template-columns: 1fr; gap: .35rem; padding: 1.1rem 0; }
    .proof-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proof-metrics > div:nth-child(2n) { padding-right: 0; }
    .experience-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.25rem; }
  }
  @media (max-width: 360px) {
    .home-hero__inner { grid-template-columns: 1fr; }
    .eyebrow { font-size: .62rem; }
    .home-hero h1 { font-size: 2.3rem; }
    .section-heading { align-items: start; }
    .section-heading > .text-link { white-space: nowrap; font-size: .78rem; }
  }
</style>
